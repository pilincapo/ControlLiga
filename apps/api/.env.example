# Plantilla: copiar a .env y ajustar valores locales. NUNCA commitear .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Debe coincidir con docker/.env
DATABASE_URL=postgresql://controlliga:change_me@localhost:5432/controlliga?schema=public

# Auth
# Origenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173
# Cookie Secure debe ser true en producción con HTTPS.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=cl_session
# Duración de sesión en milisegundos (7 días por defecto)
SESSION_TTL_MS=604800000
# Proxy inverso confiable. Vacío en local. Usar IP/CIDR exacto o cantidad de hops.
# TRUST_PROXY=127.0.0.1
# Recuperación de contraseña
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
EMAIL_FROM=no-reply@controlliga.local
# Requerido en producción para GET /api/health/db (mínimo 24 caracteres).
HEALTH_DB_TOKEN=
PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RATE_LIMIT_WINDOW_MS=900000
# Login. Limitador en memoria: solo válido para beta de una instancia.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=100

# Invitaciones
INVITACION_TTL_HORAS=168

# Producción: usar HTTPS, origen CORS exacto y remitente real.
# NODE_ENV=production
# CORS_ORIGIN=https://app.example.com
# COOKIE_SECURE=true
# PASSWORD_RESET_URL_BASE=https://app.example.com/reset-password
# EMAIL_FROM=no-reply@example.com
# HEALTH_DB_TOKEN=generar-secreto-aleatorio-de-24-caracteres-o-mas
