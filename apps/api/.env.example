# Plantilla: copiar a .env y ajustar valores locales. NUNCA commitear .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Debe coincidir con docker/.env
DATABASE_URL=postgresql://controlliga:change_me@localhost:5432/controlliga?schema=public

# Auth
# Origenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173
# Cookie Secure solo con HTTPS (producción)
COOKIE_SECURE=false
SESSION_COOKIE_NAME=cl_session
# Duración de sesión en milisegundos (7 días por defecto)
SESSION_TTL_MS=604800000
# Recuperación de contraseña
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
EMAIL_FROM=no-reply@controlliga.local
PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RATE_LIMIT_WINDOW_MS=900000
